# Скопируйте в .env и измените секреты для любого публичного стенда.
POSTGRES_PASSWORD=fsp
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Публичные адреса (для деплоя на домен: https://jobs.example.ru и https://auth.example.ru)
PUBLIC_URL=http://localhost
KEYCLOAK_PUBLIC_URL=http://localhost:8080
HTTP_PORT=80
# Секреты
ASSESSMENT_SECRET=change-me-in-production-0123456789abcdef
FSP_ID_CLIENT_SECRET=fsp-jobs-link-secret
FSP_REGISTRY_API_KEY=fsp-registry-demo-key
# keycloak | dev (dev — вход без Keycloak, только для локальной отладки!)
AUTH_MODE=keycloak
# 1 — собрать бэкенд с нейросетевыми эмбеддингами rubert-tiny2 (+~700 МБ образ)
WITH_EMBEDDINGS=0
