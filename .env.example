# Скопируйте в .env и измените секреты для любого публичного стенда.
POSTGRES_PASSWORD=fsp
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Публичные адреса (для деплоя на домен: https://jobs.example.ru и https://auth.example.ru)
PUBLIC_URL=http://localhost
KEYCLOAK_PUBLIC_URL=http://localhost:8080
HTTP_PORT=80
# Секреты
ASSESSMENT_SECRET=change-me-in-production-0123456789abcdef
FSP_ID_CLIENT_SECRET=fsp-jobs-link-secret
FSP_REGISTRY_API_KEY=fsp-registry-demo-key
# Цифровой проктор: ключ шифрования эталонов лица (AES-256-GCM) — сменить на публичном стенде
BIOMETRIC_KEY=biometric-demo-key-change-me-0123456789abcdef
# local_demo — эталон в БД платформы (демо) | ebs — Единая биометрическая система (production)
BIOMETRIC_PROVIDER=local_demo
# Срок хранения кадров с теста, дней
SNAPSHOT_RETENTION_DAYS=180
# Лимит приглашений от компании в неделю
INVITE_QUOTA_PER_WEEK=30
# Письма подтверждения и уведомления (в демо уходят в Mailpit)
EMAIL_ENABLED=true
# keycloak | dev (dev — вход без Keycloak, только для локальной отладки!)
AUTH_MODE=keycloak
# 1 — собрать бэкенд с нейросетевыми эмбеддингами rubert-tiny2 (+~700 МБ образ)
WITH_EMBEDDINGS=0

# --- Yandex Cloud AI Studio (LLM) -------------------------------------------------------
# Выключено по умолчанию: без ключей платформа работает целиком локально.
# В рантайме используется только как запасной разбор опыта в резюме (RESUME_LLM_FALLBACK).
LLM_ENABLED=0
RESUME_LLM_FALLBACK=true
# ID каталога (folder) в Yandex Cloud: b1g...
YC_FOLDER_ID=
# Секрет API-ключа сервисного аккаунта (роль ai.languageModels.user, scope yc.ai.foundationModels.execute)
YC_API_KEY=
# OpenAI-совместимый эндпоинт AI Studio
YC_LLM_BASE_URL=https://ai.api.cloud.yandex.net/v1
# Заголовок x-data-logging-enabled: false — Яндекс не логирует запросы (ПДн, 152-ФЗ)
YC_DATA_LOGGING=false
# Модели (URI собирается как gpt://<YC_FOLDER_ID>/<model>)
LLM_MODEL_EXTRACT=yandexgpt-5-lite
LLM_MODEL_GENERATOR=deepseek-v4.1-flash
LLM_MODEL_JUDGE=yandexgpt-5.1
# Панель LLM-респондентов разной силы для калибровки заданий (от слабых к сильным)
LLM_PANEL=gpt-oss-20b,qwen3.6-35b-a3b,yandexgpt-5-lite,gpt-oss-120b,yandexgpt-5.1,deepseek-v4.1-flash
# Потолок расходов на один прогон офлайн-калибровки, ₽ (защита от случайного перерасхода)
LLM_BUDGET_RUB=3000

# Механика подбора: v5 (формула, по умолчанию) | hybrid (v5 + кросс-энкодер, нужен WITH_EMBEDDINGS=1)
# | v1 (исходная формула) | v4 (прежний гибрид на v1)
FSP_RANKER=v5
# Эмбеддинги: auto (rubert-tiny2, если установлен, иначе TF-IDF) | hashing (без моделей)
FSP_EMBEDDINGS=auto
