# Шаблон: при старте контейнера nginx подставляет ${BACKEND_URL} и ${KEYCLOAK_URL} (envsubst).
# В Docker Compose это внутренние адреса сервисов; на отдельном хостинге фронтенда — внешний адрес
# стенда, например http://203.0.113.10:18088 и http://203.0.113.10:18088/auth.
# Браузер ходит только на свой origin: нет mixed content (HTTPS-фронт → HTTP-бэкенд) и CORS.

# X-Forwarded-Proto от внешнего прокси (TLS на хостинге фронтенда) передаём дальше по цепочке
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    client_max_body_size 6m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    proxy_http_version 1.1;
    proxy_connect_timeout 10s;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;

    # API бэкенда (включая Swagger /api/docs и callback ФСП ID)
    location /api/ {
        proxy_pass ${BACKEND_URL}/api/;
        proxy_set_header Host $host;
        proxy_read_timeout 60s;
    }

    # Keycloak под /auth/ (KEYCLOAK_PUBLIC_URL=<PUBLIC_URL>/auth): тот же origin и один проброшенный порт.
    # Админка Keycloak через этот путь закрыта — она доступна только напрямую (локально :18080).
    location /auth/admin/ {
        return 404;
    }
    location /auth/ {
        proxy_pass ${KEYCLOAK_URL}/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        # заголовки ответов Keycloak с cookie не помещаются в буферы по умолчанию (502)
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
        proxy_read_timeout 60s;
    }

    # модели цифрового проктора (Human): раздаются своим сервером, без внешних CDN
    location /models/ {
        expires 30d;
        add_header Cache-Control "public";
    }

    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # SPA: все остальные пути — index.html
    location / {
        try_files $uri $uri/ /index.html;
        add_header X-Frame-Options "SAMEORIGIN";  # SAMEORIGIN: скрытый iframe проверки SSO Keycloak
        add_header X-Content-Type-Options "nosniff";
        add_header Referrer-Policy "strict-origin-when-cross-origin";
        # камера и микрофон — только для своего origin (цифровой проктор); браузер всё равно спросит разрешение
        add_header Permissions-Policy "camera=(self), microphone=(self), geolocation=()";
    }
}
